# Runtime secrets: set in the hosting provider, never commit real values.
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional comma-separated model IDs approved for this deployment.
ALLOWED_CHAT_MODELS=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CLIENT_ID=
CLIENT_SECRET=
# Use the exact production origins and registered Google redirect URI.
FRONTEND_URL=https://YOUR_HOST/app
REDIRECT_URI=https://YOUR_HOST/auth/google/callback
CORS_ORIGINS=https://YOUR_HOST
MAX_UPLOAD_BYTES=20971520
# Leave blank for same-origin frontend/backend hosting.
VITE_BACKEND_URL=
# Local development only (when DATABASE_URL/Chroma Cloud credentials are absent):
# MEMORY_SQLITE_PATH=/absolute/path/to/local/memory.db
# CHROMA_LOCAL_PATH=/absolute/path/to/local/chroma
